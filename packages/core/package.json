{
  "name": "@lab-agent-workbench/core",
  "version": "0.1.0",
  "description": "Configuration, profiles, policies and redaction for Lab Agent Workbench",
  "keywords": [
    "agent",
    "policy",
    "config"
  ],
  "license": "MIT",
  "homepage": "https://github.com/trongthuyen/lab-agent-workbench#readme",
  "bugs": {
    "url": "https://github.com/trongthuyen/lab-agent-workbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trongthuyen/lab-agent-workbench.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node .test-dist/test/all.test.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
