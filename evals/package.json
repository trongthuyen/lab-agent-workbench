{
  "name": "@lab-agent-workbench/evals",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic evaluation scenarios and runner for Lab Agent Workbench",
  "type": "module",
  "scripts": {
    "bench": "node dist/bench.js",
